    @keyframes hdd-blink {
        0% {
            background: #ff4030;
            box-shadow: 0 0 0.3rem 0.06rem rgba(255, 64, 48, 0.9);
        }
        50% {
            background: #5a1512;
            box-shadow: 0 0 0 0 rgba(255, 64, 48, 0);
