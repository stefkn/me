<script>
    const snakeChar = "0";
    const food = ".";
    const lineText = "██████████████████ ";
    const COLS = 19;
    const ROWS = 9;

    const isTouchDevice =
        "ontouchstart" in window || navigator.maxTouchPoints > 0;
    const moveHint = isTouchDevice
        ? ["SWIPE", "TO", "MOVE"]
        : ["WASD", "OR", "ARROWS"];
    const hintRow = ("█" + moveHint.join("█") + "█").padEnd(18, "█") + " ";

    const MODE = {
        BOOT: "boot",
        MENU: "menu",
        SNAKE: "snake",
        INFO: "info",
    } as const;
    type Mode = (typeof MODE)[keyof typeof MODE];

    const APPS = [
        { id: "snake", label: "SNAKE" },
        { id: "about", label: "ABOUT" },
        { id: "posts", label: "POSTS" },
    ] as const;

    let mode: Mode = MODE.BOOT;
    let selectedApp = 0;
    let screenRows: Array<string> = new Array(ROWS).fill("");
    let bootCancelled = false;
    let bootedEl: HTMLElement | null = null;
    let desktopHovered = false;
    let ledIdleTimer: ReturnType<typeof setTimeout> | null = null;

    let gameStarted = false;
    let grid = makeGrid();
    let position = 0;
    let posArr: Array<number> = [];
    let foodPosition = -1;
    let snakeLen = 12;
    let snakeSpeed = 600;
    let playerMoveInterval: ReturnType<typeof setInterval> | null = null;
    let currentDirectionKey = "";

    let touchStartX = 0;
    let touchStartY = 0;
    let touchInGameArea = false;

    function getGameElem() {
        return document.getElementById("game");
    }

    function makeGrid() {
        return lineText.repeat(4) + hintRow + lineText.repeat(4);
    }

    function renderScreen() {
        const el = getGameElem();
        if (el) el.textContent = screenRows.join("\n");
    }

    function renderGame() {
        const el = getGameElem();
        if (!el) return;
        const rows: Array<string> = [];
        for (let r = 0; r < ROWS; r++) {
            rows.push(grid.slice(r * COLS, (r + 1) * COLS));
        }
        el.textContent = rows.join("\n");
    }

    function setCharAt(str: string, index: number, chr: string) {
        if (index > str.length - 1) return str;
        grid = str.substring(0, index) + chr + str.substring(index + 1);
        return grid;
    }

    // ---------- terminal / boot sequence ----------

    function sleep(ms: number) {
        return new Promise<void>((resolve) => setTimeout(resolve, ms));
    }

    function scrollUp() {
        screenRows.shift();
        screenRows.push("");
    }

    function typeLine(text: string, speed = 16) {
        return new Promise<void>((resolve) => {
            scrollUp();
            let i = 0;
            let blink = true;
            const timer = setInterval(() => {
                if (bootCancelled) {
                    clearInterval(timer);
                    resolve();
                    return;
                }
                blink = !blink;
                const cursor = i < text.length ? (blink ? "_" : " ") : "_";
                screenRows[ROWS - 1] = text.slice(0, i) + cursor;
                renderScreen();
                if (i >= text.length) {
                    clearInterval(timer);
                    resolve();
                }
                i++;
            }, speed);
        });
    }

    function memTest() {
        return new Promise<void>((resolve) => {
            scrollUp();
            let mem = 0;
            const timer = setInterval(() => {
                if (bootCancelled) {
                    clearInterval(timer);
                    resolve();
                    return;
                }
                mem += 64;
                screenRows[ROWS - 1] =
                    "MEMORY " + String(mem).padStart(3, "0") + "K OK";
                renderScreen();
                if (mem >= 640) {
                    clearInterval(timer);
                    resolve();
                }
            }, 45);
        });
    }

    async function blankLine(ms: number) {
        await sleep(ms);
        if (bootCancelled) return;
        scrollUp();
        renderScreen();
    }

    async function runBoot() {
        const el = getGameElem();
        if (!el) return;

        bootCancelled = false;
        mode = MODE.BOOT;
        screenRows = new Array(ROWS).fill("");
        renderScreen();
        el.style.display = "block";
        setLedBusy(true);

        const steps: Array<() => Promise<void> | void> = [
            () => typeLine("SBIOS V1.0"),
            () => typeLine("(C) 1989 STESOFT"),
            () => typeLine("BIOS DATE 01/01/89"),
            () => blankLine(180),
            () => typeLine("CPU 8088 @4.77MHZ"),
            () => memTest(),
            () => typeLine("KEYBOARD.......OK"),
            () => typeLine("FDD 0: 360KB OK"),
            () => typeLine("FDD 1: 360KB OK"),
            () => typeLine("CGA 80X25 OK"),
            () => typeLine("CMOS..........OK"),
            () => blankLine(220),
            () => typeLine("BOOTING S-DOS"),
            () => typeLine("S-DOS V3.3"),
            () => sleep(450),
        ];

        for (const step of steps) {
            if (bootCancelled || !el.isConnected) return;
            await step();
        }

        if (!bootCancelled && el.isConnected) goToMenu();
    }

    function skipBoot() {
        if (mode !== MODE.BOOT) return;
        bootCancelled = true;
        goToMenu();
    }

    // ---------- HDD activity LED ----------

    function setLedBusy(busy: boolean) {
        const led = document.getElementById("hdd-led");
        if (!led) return;
        led.classList.toggle("is-busy", busy);
        if (busy && ledIdleTimer) {
            clearTimeout(ledIdleTimer);
            ledIdleTimer = null;
        }
    }

    function ledBlip(ms = 90) {
        const led = document.getElementById("hdd-led");
        if (!led) return;
        led.classList.add("is-active");
        setTimeout(() => led.classList.remove("is-active"), ms);
    }

    function scheduleLedIdle() {
        if (ledIdleTimer) clearTimeout(ledIdleTimer);
        ledIdleTimer = setTimeout(() => {
            ledBlip(60 + Math.random() * 90);
            scheduleLedIdle();
        }, 1500 + Math.random() * 4500);
    }

    // ---------- app menu ----------

    function center(text: string, width: number) {
        const pad = Math.max(0, width - text.length);
        const left = Math.floor(pad / 2);
        return " ".repeat(left) + text + " ".repeat(pad - left);
    }

    function menuItem(i: number) {
        const label = (i === selectedApp ? "> " : "  ") + APPS[i].label;
        return "│ " + label + " ".repeat(COLS - 4 - label.length) + " │";
    }

    function renderMenu() {
        const inner = COLS - 2;
        screenRows = [
            "┌" + "─".repeat(inner) + "┐",
            "│" + center("STEFOS V3.3", inner) + "│",
            "│" + " ".repeat(inner) + "│",
            menuItem(0),
            menuItem(1),
            menuItem(2),
            "│" + " ".repeat(inner) + "│",
            "└" + "─".repeat(inner) + "┘",
            "^/v MOVE  ENTER GO".padEnd(COLS, " "),
        ];
        renderScreen();
    }

    function goToMenu() {
        bootCancelled = true;
        mode = MODE.MENU;
        selectedApp = 0;
        renderMenu();
        setLedBusy(false);
        ledBlip(140);
        scheduleLedIdle();
    }

    function menuMove(dir: number) {
        if (mode !== MODE.MENU) return;
        selectedApp = (selectedApp + dir + APPS.length) % APPS.length;
        renderMenu();
        ledBlip(45);
    }

    function menuOpen() {
        if (mode !== MODE.MENU) return;
        const app = APPS[selectedApp];
        ledBlip(120);
        if (app.id === "snake") startGame();
        else openInfo(app.id);
    }

    function openInfo(id: string) {
        mode = MODE.INFO;
        const about = [
            "ABOUT THIS DOS",
            "----------------",
            "",
            "SDOS IS A CUTTING-",
            "EDGE PERSONAL",
            "COMPUTER OPERATING",
            "SYSTEM.",
            "",
            "ESC/Q TO RETURN",
        ];
        const posts = [
            "POSTS APP",
            "----------------",
            "",
            "COMING SOON.",
            "",
            "STEFAN WRITES",
            "ABOUT CODE, ETC.",
            "",
            "ESC/Q TO RETURN",
        ];
        screenRows = (id === "about" ? about : posts).slice(0, ROWS);
        while (screenRows.length < ROWS) screenRows.push("");
        renderScreen();
    }

    // ---------- snake ----------

    function updateSnakePosition(pos: number) {
        posArr.push(position);
        position = position + pos;

        if (!(foodPosition === position)) {
            posArr.push(position);
        }
        grid = lineText.repeat(9);
    }

    function getNewFoodPos() {
        let newFoodPos = Math.floor(Math.random() * 17 * 9);
        const currSnake = posArr.reverse().slice(0, snakeLen + 1);
        while ((newFoodPos + 1) % 19 === 0 || currSnake.includes(newFoodPos)) {
            newFoodPos = Math.floor(Math.random() * 17 * 9);
        }
        return newFoodPos;
    }

    function handleDirectionKey(key: string) {
        currentDirectionKey = key;

        if (key == "w") {
            if (0 <= position && position <= 17) {
                updateSnakePosition(152);
                return;
            }
            updateSnakePosition(-19);
        }
        if (key == "s") {
            if (position >= 152) {
                updateSnakePosition(-152);
                return;
            }
            updateSnakePosition(19);
        }
        if (key == "a") {
            if (position % 19 === 0) {
                updateSnakePosition(17);
                return;
            }
            updateSnakePosition(-1);
        }
        if (key == "d") {
            if ((position + 2) % 19 === 0) {
                updateSnakePosition(-17);
                return;
            }
            updateSnakePosition(1);
        }
    }

    function startGame() {
        const gameElem = getGameElem();
        if (!gameElem) return;

        if (playerMoveInterval) {
            clearInterval(playerMoveInterval);
            playerMoveInterval = null;
        }

        mode = MODE.SNAKE;
        gameStarted = true;
        gameElem.style.display = "block";
        grid = makeGrid();
        posArr = [];
        position = 0;
        foodPosition = 0;
        snakeLen = 12;
        snakeSpeed = 600;
        currentDirectionKey = "";

        renderGame();

        document.getElementById("background")?.classList.add("playing");
        updateFocusEffects();
    }

    function endGame() {
        if (playerMoveInterval) {
            clearInterval(playerMoveInterval);
            playerMoveInterval = null;
        }
        gameStarted = false;
        mode = MODE.INFO;
        document.getElementById("background")?.classList.remove("playing");
        updateFocusEffects();

        screenRows = [
            "",
            "",
            center("GAME OVER", COLS),
            "",
            center("SCORE " + (snakeLen - 12), COLS),
            "",
            "",
            center("ESC/Q TO RETURN", COLS),
            "",
        ];
        renderScreen();
    }

    function move(key: string, user = true) {
        if (!gameStarted || mode !== MODE.SNAKE) return;

        if (currentDirectionKey === key && user) return;

        if (playerMoveInterval) {
            clearInterval(playerMoveInterval);
        }

        playerMoveInterval = setInterval(move, snakeSpeed, key, false);

        handleDirectionKey(key);

        const currSnake = posArr.reverse().slice(0, snakeLen + 1);

        currSnake.forEach((pos) => {
            setCharAt(grid, pos, snakeChar);
        });
        setCharAt(grid, foodPosition, food);

        if (foodPosition === position) {
            posArr.push(position);
            setCharAt(grid, foodPosition, snakeChar);
            snakeLen++;
            snakeSpeed = snakeSpeed / 1.1;
            foodPosition = getNewFoodPos();
            setCharAt(grid, foodPosition, food);
        }

        renderGame();

        if (
            gameStarted &&
            position !== 0 &&
            currSnake.slice(1).includes(position)
        ) {
            endGame();
        }
    }

    // ---------- input ----------

    function keyDownHandler(e: KeyboardEvent) {
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        if (mode === MODE.BOOT) {
            if (
                [
                    " ",
                    "ArrowUp",
                    "ArrowDown",
                    "ArrowLeft",
                    "ArrowRight",
                    "PageUp",
                    "PageDown",
                    "Home",
                    "End",
                ].includes(e.key)
            ) {
                e.preventDefault();
            }
            skipBoot();
            return;
        }

        if (mode === MODE.MENU) {
            const isArrow = e.key === "ArrowUp" || e.key === "ArrowDown";
            if (isArrow && !desktopHovered) return;

            if (e.key === "ArrowUp" || e.key === "w") {
                e.preventDefault();
                menuMove(-1);
            } else if (e.key === "ArrowDown" || e.key === "s") {
                e.preventDefault();
                menuMove(1);
            } else if (
                e.key === "Enter" ||
                e.key === "g" ||
                (e.key === " " && desktopHovered)
            ) {
                e.preventDefault();
                menuOpen();
            }
            return;
        }

        if (mode === MODE.INFO) {
            if (["Escape", "q", "Enter", "Backspace", " "].includes(e.key)) {
                e.preventDefault();
                goToMenu();
            }
            return;
        }

        if (mode === MODE.SNAKE) {
            if (e.key === "Escape" || e.key === "q" || e.key === "Backspace") {
                e.preventDefault();
                goToMenu();
                return;
            }
            const arrowMap: Record<string, string> = {
                ArrowUp: "w",
                ArrowDown: "s",
                ArrowLeft: "a",
                ArrowRight: "d",
            };
            const key = arrowMap[e.key] ?? e.key;
            if (["w", "a", "s", "d"].includes(key)) {
                e.preventDefault();
                move(key);
            }
        }
    }

    function onTouchStart(e: TouchEvent) {
        const touch = e.touches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        touchInGameArea = touch.clientY < window.innerHeight / 2;
    }

    function onTouchMove(e: TouchEvent) {
        if (touchInGameArea && (mode === MODE.SNAKE || mode === MODE.MENU)) {
            e.preventDefault();
        }
    }

    function onTouchEnd(e: TouchEvent) {
        if (!touchInGameArea) return;

        const touch = e.changedTouches[0];
        const dx = touch.clientX - touchStartX;
        const dy = touch.clientY - touchStartY;
        const SWIPE_THRESHOLD = 24;
        const isTap =
            Math.abs(dx) < SWIPE_THRESHOLD && Math.abs(dy) < SWIPE_THRESHOLD;

        if (mode === MODE.BOOT) {
            skipBoot();
            return;
        }

        if (mode === MODE.INFO) {
            goToMenu();
            return;
        }

        if (mode === MODE.MENU) {
            if (isTap) {
                menuOpen();
            } else if (Math.abs(dy) > Math.abs(dx)) {
                menuMove(dy > 0 ? 1 : -1);
            }
            return;
        }

        if (mode === MODE.SNAKE) {
            if (isTap) return;
            if (Math.abs(dx) > Math.abs(dy)) {
                move(dx > 0 ? "d" : "a");
            } else {
                move(dy > 0 ? "s" : "w");
            }
        }
    }

    function onSceneEnter() {
        desktopHovered = true;
    }

    function onSceneLeave() {
        desktopHovered = false;
    }

    let boundBg: HTMLElement | null = null;
    let boundScene: HTMLElement | null = null;

    function bindControls() {
        const bg = document.getElementById("background");

        if (bg && bg !== boundBg) {
            if (boundBg) {
                boundBg.removeEventListener("touchstart", onTouchStart);
                boundBg.removeEventListener("touchmove", onTouchMove);
                boundBg.removeEventListener("touchend", onTouchEnd);
            }
            bg.addEventListener("touchstart", onTouchStart, { passive: false });
            bg.addEventListener("touchmove", onTouchMove, { passive: false });
            bg.addEventListener("touchend", onTouchEnd, { passive: false });
            boundBg = bg;
        }

        const scene = document.querySelector<HTMLElement>(".scene");
        if (scene && scene !== boundScene) {
            if (boundScene) {
                boundScene.removeEventListener("mouseenter", onSceneEnter);
                boundScene.removeEventListener("mouseleave", onSceneLeave);
            }
            scene.addEventListener("mouseenter", onSceneEnter);
            scene.addEventListener("mouseleave", onSceneLeave);
            boundScene = scene;
        }
    }

    function updateFocusEffects() {
        if (!isTouchDevice) return;

        const scene = document.querySelector<HTMLElement>(".scene");
        if (!scene) return;

        const scrolled = window.scrollY > 40;
        const gameFocused = mode === MODE.SNAKE && !scrolled;

        document.body.classList.toggle("snake-focus", gameFocused);
        scene.classList.toggle("is-scrolled", scrolled);
    }

    function fitScene() {
        const scene = document.querySelector<HTMLElement>(".scene");
        const pre = document.querySelector<HTMLElement>("pre.background-ascii");
        if (!scene || !pre) return;

        scene.style.transform = "";

        if (!window.matchMedia("(max-width: 700px)").matches) return;

        const vw = document.documentElement.clientWidth;
        const width = pre.getBoundingClientRect().width;
        const scale = Math.min(1, (vw - 16) / width);
        scene.style.transform = `scale(${scale})`;
    }

    function initOS() {
        const el = getGameElem();
        if (!el) return;

        bindControls();

        if (el === bootedEl) return;
        bootedEl = el;
        bootCancelled = true;
        runBoot();
    }

    window.addEventListener("keydown", keyDownHandler);
    window.addEventListener("scroll", updateFocusEffects, { passive: true });
    window.addEventListener("resize", fitScene);

    document.addEventListener("astro:page-load", () => {
        bindControls();
        updateFocusEffects();
        fitScene();
        initOS();
    });

    document.addEventListener("astro:before-swap", () => {
        bootCancelled = true;
        gameStarted = false;
        if (playerMoveInterval) {
            clearInterval(playerMoveInterval);
            playerMoveInterval = null;
        }
        if (ledIdleTimer) {
            clearTimeout(ledIdleTimer);
            ledIdleTimer = null;
        }
    });

    bindControls();
    updateFocusEffects();
    fitScene();
    initOS();
</script>
