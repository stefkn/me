---
import TableOfContentsHeading from "./TableOfContentsHeading.astro";

const { headings } = Astro.props;
const toc = buildToc(headings);

function buildToc(headings: any) {
  const toc: any = [];
  const parentHeadings = new Map();
  headings.forEach((h: any) => {
    const heading = { ...h, subheadings: [] };
    parentHeadings.set(heading.depth, heading);
    if (heading.depth === 2) {
      toc.push(heading);
    } else {
      parentHeadings.get(heading.depth - 1).subheadings.push(heading);
    }
  });
  return toc;
}
---

<nav class="toc">
  <ul>
    {toc.map((heading: any) => <TableOfContentsHeading heading={heading} />)}
  </ul>
  <svg class="toc-progress" xmlns="http://www.w3.org/2000/svg">
    <path
      class="toc-marker"
      fill="none"
      stroke="#ff27a7"
      stroke-width="4"
      stroke-dashoffset="1"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</nav>

<style>
  nav.toc {
    position: relative;
    font-family: monospace;
    margin: 2rem 0rem 1rem -1rem;
    font-size: var(--text-sm);
  }
  .toc-progress {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  path.toc-marker {
    transition: stroke-dasharray 0.3s ease;
    pointer-events: none;
  }
</style>

<script>
  // original inspiration: https://kld.dev/toc-animation/
  const GUTTER = 10;

  document.addEventListener("astro:page-load", () => {
    const linkStarts = new WeakMap<Element, number>();
    const linkEnds = new WeakMap<Element, number>();

    function textRect(el: Element): DOMRect {
      const rects = el.getClientRects();
      return rects.length ? rects[0] : el.getBoundingClientRect();
    }

    function drawPath() {
      const path = document.querySelector("path.toc-marker") as SVGPathElement;
      const links = Array.from(document.querySelectorAll("nav.toc a"));
      if (!links.length || !path) return;

      const svg = path.ownerSVGElement as SVGSVGElement;
      const svgRect = svg.getBoundingClientRect();

      const segments = links.map((link) => {
        const rect = textRect(link);
        return {
          link,
          x: rect.left - svgRect.left - GUTTER,
          top: rect.top - svgRect.top,
          bottom: rect.bottom - svgRect.top,
        };
      });

      const d: string[] = [];
      let prev: (typeof segments)[number] | null = null;

      segments.forEach((seg) => {
        if (!prev) {
          linkStarts.set(seg.link, 0);
          d.push(
            "M",
            String(seg.x),
            String(seg.top),
            "L",
            String(seg.x),
            String(seg.bottom),
          );
        } else {
          if (prev.x !== seg.x) {
            d.push("L", String(prev.x), String(seg.top));
          }
          d.push("L", String(seg.x), String(seg.top));
          path.setAttribute("d", d.join(" "));
          linkStarts.set(seg.link, path.getTotalLength());
          d.push("L", String(seg.x), String(seg.bottom));
        }
        prev = seg;
        path.setAttribute("d", d.join(" "));
        linkEnds.set(seg.link, path.getTotalLength());
      });
    }

    function addIntersectionObserver() {
      function updatePath() {
        const path = document.querySelector("path.toc-marker") as SVGPathElement;
        if (!path) return;

        const pathLength = path.getTotalLength();
        const activeLinks = document.querySelectorAll("a.active");
        let linkStart = pathLength;
        let linkEnd = 0;

        activeLinks.forEach((link) => {
          linkStart = Math.min(linkStart, linkStarts.get(link) ?? 0);
          linkEnd = Math.max(linkEnd, linkEnds.get(link) ?? 0);
        });

        path.style.display = activeLinks.length ? "inline" : "none";
        path.setAttribute(
          "stroke-dasharray",
          `1 ${linkStart} ${linkEnd - linkStart} ${pathLength}`,
        );
      }

      function addResizeObserver() {
        const toc = document.querySelector("nav.toc");
        if (!toc) return;
        const observer = new ResizeObserver(() => {
          drawPath();
          updatePath();
        });
        observer.observe(toc);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const path = document.querySelector("path.toc-marker");
          if (!path) return;
          const id = entry.target.getAttribute("id");
          const link = document.querySelector(`nav.toc li a[href="#${id}"]`);
          if (!link) return;

          const removing = entry.intersectionRatio <= 0;
          const onlyOneActive =
            document.querySelectorAll("a.active").length === 1;

          if (removing && onlyOneActive) {
            document.querySelectorAll("a.active")[0].classList.remove("active");
            return;
          }

          if (removing) {
            link.classList.remove("active");
          } else {
            link.classList.add("active");
          }
          updatePath();
        });
      });

      addResizeObserver();

      document
        .querySelectorAll(
          "#main-wrapper>h2,#main-wrapper>h3,#main-wrapper>h4,#main-wrapper>h5,#main-wrapper>section>h2",
        )
        .forEach((section) => {
          observer.observe(section);
        });
    }

    if (window.visualViewport && window.visualViewport.width > 930) {
      drawPath();
      addIntersectionObserver();
    }
  });
</script>
