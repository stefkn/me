---
import { generateArt } from "../lib/art";

interface Props {
  slug: string;
  alt: string;
  hue?: number;
  seed?: number;
}

const { slug, alt, hue, seed } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const cfg = generateArt(slug, { hue, seed });
const heroUrl = `${base}generated/art/${slug}-hero.png`;
const configJson = JSON.stringify(cfg);
---

<div class="hero-art" data-art-config={configJson}>
  <img
    class="hero-art-img"
    src={heroUrl}
    alt={alt}
    width={cfg.width}
    height={cfg.height}
  />
  <canvas class="hero-art-canvas" aria-hidden="true"></canvas>
  <canvas class="hero-art-canvas3d" aria-hidden="true"></canvas>
</div>

<script>
  import { createHero3D, type Hero3DRenderer } from "../lib/hero3d";

  interface Field {
    id: string;
    cx: number;
    cy: number;
    rx: number;
    ry: number;
    colors: string[];
    opacity: number;
    driftAmp: number;
    driftSpeed: number;
    driftSpeedY: number;
    hueDrift: number;
    phase: number;
  }

  interface ArtConfig {
    seed: number;
    width: number;
    height: number;
    background: string;
    backgroundBottom: string;
    accent: string;
    palette: string[];
    neon: string[];
    fields: Field[];
  }

  function shiftedColor(hex: string, hueShift: number, alpha: number): string {
    const m = hex.replace("#", "");
    let r = parseInt(m.slice(0, 2), 16) / 255;
    let g = parseInt(m.slice(2, 4), 16) / 255;
    let b = parseInt(m.slice(4, 6), 16) / 255;
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const l = (max + min) / 2;
    const d = max - min;
    if (d > 0.0001) {
      const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      let h =
        max === r ? (g - b) / d + (g < b ? 6 : 0) :
        max === g ? (b - r) / d + 2 :
        (r - g) / d + 4;
      h = h * 60 + hueShift;
      h = ((h % 360) + 360) % 360;
      const c = (1 - Math.abs(2 * l - 1)) * s;
      const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
      const mm = l - c / 2;
      if (h < 60) {
        r = c;
        g = x;
        b = 0;
      } else if (h < 120) {
        r = x;
        g = c;
        b = 0;
      } else if (h < 180) {
        r = 0;
        g = c;
        b = x;
      } else if (h < 240) {
        r = 0;
        g = x;
        b = c;
      } else if (h < 300) {
        r = x;
        g = 0;
        b = c;
      } else {
        r = c;
        g = 0;
        b = x;
      }
      r = (r + mm) * 255;
      g = (g + mm) * 255;
      b = (b + mm) * 255;
    } else {
      r *= 255;
      g *= 255;
      b *= 255;
    }
    return `rgba(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)}, ${alpha})`;
  }

  let rafId: number | null = null;
  let root: HTMLElement | null = null;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let cfg: ArtConfig | null = null;
  let renderer3d: Hero3DRenderer | null = null;
  let observer: IntersectionObserver | null = null;
  let heroVisible = true;
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  function stopLoop() {
    if (rafId != null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
  }

  function updateLoop() {
    const active =
      !reducedMotion && heroVisible && !document.hidden && root != null;
    if (active) {
      if (rafId == null) {
        rafId = requestAnimationFrame(frame);
      }
    } else {
      stopLoop();
    }
  }

  function sizeCanvas() {
    if (!canvas || !cfg || !root) return;
    const img = root.querySelector<HTMLImageElement>(".hero-art-img");
    const cssWidth = img ? img.offsetWidth : cfg.width;
    const cssHeight = img && img.offsetHeight
      ? img.offsetHeight
      : Math.round(cssWidth * (cfg.height / cfg.width));
    const pxW = cssWidth;
    const pxH = cssHeight;
    canvas.style.width = `${cssWidth}px`;
    canvas.style.height = `${cssHeight}px`;
    canvas.width = pxW;
    canvas.height = pxH;
    if (renderer3d) {
      const canvas3d = root.querySelector<HTMLCanvasElement>(".hero-art-canvas3d");
      if (canvas3d) {
        canvas3d.style.width = `${cssWidth}px`;
        canvas3d.style.height = `${cssHeight}px`;
        renderer3d.resize(pxW, pxH);
      }
    }
  }

  function render(t: number) {
    if (!canvas || !ctx || !cfg) return;
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    const base = ctx.createLinearGradient(0, 0, 0, h);
    base.addColorStop(0, cfg.background);
    base.addColorStop(1, cfg.backgroundBottom);
    ctx.fillStyle = base;
    ctx.fillRect(0, 0, w, h);

    for (const f of cfg.fields) {
      const cx =
        f.cx + f.driftAmp * Math.sin(t * f.driftSpeed + f.phase);
      const cy =
        f.cy +
        f.driftAmp * Math.cos(t * f.driftSpeedY + f.phase * 1.3);
      const hueShift = t * f.hueDrift;
      const x = cx * w;
      const y = cy * h;
      const rx = f.rx * w;
      const ry = f.ry * h;
      const mid = f.colors[1] ?? f.colors[0];
      const last = f.colors[f.colors.length - 1];

      ctx.save();
      ctx.translate(x, y);
      ctx.scale(1, ry / rx);
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, rx);
      g.addColorStop(0, shiftedColor(f.colors[0], hueShift, f.opacity));
      g.addColorStop(0.45, shiftedColor(mid, hueShift, f.opacity * 0.75));
      g.addColorStop(1, shiftedColor(last, hueShift, 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(0, 0, rx, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }

  function frame(now: number) {
    const t = now / 1000;
    render(t);
    if (renderer3d) {
      renderer3d.render(t, window.scrollY);
    }
    if (root && !root.classList.contains("is-animated")) {
      root.classList.add("is-animated");
    }
    rafId = requestAnimationFrame(frame);
  }

  function initArt() {
    const next = document.querySelector<HTMLElement>(".hero-art");
    if (!next) {
      stopLoop();
      if (observer) {
        observer.disconnect();
        observer = null;
      }
      root = null;
      canvas = null;
      ctx = null;
      cfg = null;
      renderer3d = null;
      return;
    }
    if (next.dataset.bound) return;
    next.dataset.bound = "true";

    const raw = next.getAttribute("data-art-config");
    if (!raw) return;

    root = next;
    cfg = JSON.parse(raw) as ArtConfig;
    canvas = next.querySelector<HTMLCanvasElement>(".hero-art-canvas");
    ctx = canvas ? canvas.getContext("2d") : null;
    if (!canvas || !ctx) return;

    renderer3d = null;
    const canvas3d = next.querySelector<HTMLCanvasElement>(".hero-art-canvas3d");
    if (canvas3d) {
      renderer3d = createHero3D(canvas3d, cfg.neon, cfg.accent, 0.9);
    }

    if (observer) {
      observer.disconnect();
    }
    heroVisible = true;
    observer = new IntersectionObserver((entries) => {
      heroVisible = entries[0]?.isIntersecting ?? true;
      updateLoop();
    });
    const heroEl =
      next.querySelector<HTMLElement>(".hero-art-img") ?? next;
    observer.observe(heroEl);

    stopLoop();
    sizeCanvas();
    render(0);
    if (renderer3d) {
      renderer3d.render(0, window.scrollY);
    }
    root.classList.add("is-animated");
    updateLoop();
  }

  document.addEventListener("astro:page-load", initArt);
  document.addEventListener("visibilitychange", updateLoop);
  window.addEventListener("resize", () => {
    if (root) sizeCanvas();
  });

  initArt();
</script>

<style>
  .hero-art {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    z-index: -1;
  }

  @media (max-width: 630px) {
    .hero-art {
      aspect-ratio: 10 / 13;
    }
  }

  .hero-art-img,
  .hero-art-canvas,
  .hero-art-canvas3d {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(
      ellipse 200% 120% at 40% 0%,
      #000 48%,
      rgba(0, 0, 0, 0.7) 60%,
      rgba(0, 0, 0, 0.35) 71%,
      rgba(0, 0, 0, 0.1) 79%,
      transparent 84%
    );
    mask-image: radial-gradient(
      ellipse 200% 120% at 40% 0%,
      #000 48%,
      rgba(0, 0, 0, 0.7) 60%,
      rgba(0, 0, 0, 0.35) 71%,
      rgba(0, 0, 0, 0.1) 79%,
      transparent 84%
    );
    transform: scale(1.12);
  }

  .hero-art-img,
  .hero-art-canvas {
    -webkit-filter: blur(18px) saturate(1.2);
    filter: blur(18px) saturate(1.2);
  }

  .hero-art-canvas3d {
    -webkit-filter: blur(10px) saturate(1.4);
    filter: blur(10px) saturate(1.4);
    mix-blend-mode: plus-lighter;
  }

  .hero-art-img {
    object-fit: cover;
    opacity: 1;
    transition: opacity 2s ease;
  }

  .hero-art-canvas,
  .hero-art-canvas3d {
    opacity: 0;
    transition: opacity 2s ease;
  }

  .hero-art.is-animated .hero-art-img {
    opacity: 0;
  }

  .hero-art.is-animated .hero-art-canvas,
  .hero-art.is-animated .hero-art-canvas3d {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art-img,
    .hero-art-canvas,
    .hero-art-canvas3d {
      transition: none;
    }
  }
</style>
