---
import { hashString } from "../lib/rng";

interface Props {
  slug: string;
  alt: string;
  seed?: number;
}

const { slug, alt, seed: seedProp } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const seed = seedProp ?? hashString(slug);
const heroUrl = `${base}generated/art/${slug}-hero.png`;
---

<div class="hero-art" data-art-seed={seed}>
  <img
    class="hero-art-img"
    src={heroUrl}
    alt={alt}
    width={1920}
    height={1080}
  />
  <canvas class="hero-art-canvas" aria-hidden="true"></canvas>
  <canvas class="hero-art-canvas3d" aria-hidden="true"></canvas>
</div>

<script>
  import { generateBankFields, sampleGrid, BANK } from "../lib/art";
  import { createHero3D, type Hero3DRenderer } from "../lib/hero3d";
  import type { ArtConfig } from "../lib/types";

  const GRID_W = 76;
  const GRID_H = 43;

  let tiny: HTMLCanvasElement | null = null;
  let tinyCtx: CanvasRenderingContext2D | null = null;
  let grainCanvas: HTMLCanvasElement | null = null;
  let cfg: ArtConfig | null = null;

  let rafId: number | null = null;
  let root: HTMLElement | null = null;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let renderer3d: Hero3DRenderer | null = null;
  let observer: IntersectionObserver | null = null;
  let heroVisible = true;
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  function rgbToHex(rgb: [number, number, number]): string {
    const toHex = (v: number) =>
      Math.round(Math.min(255, Math.max(0, v)))
        .toString(16)
        .padStart(2, "0");
    return `#${toHex(rgb[0])}${toHex(rgb[1])}${toHex(rgb[2])}`;
  }

  function derive3dColors(cfg: ArtConfig): { neon: string[]; accent: string } {
    const rich = cfg.fields.filter((f) => f.core > 0);
    const vivid = rich.length > 0 ? rich : cfg.fields;
    const neon = Array.from({ length: 4 }, (_, i) => {
      const f = vivid[i % vivid.length] ?? vivid[vivid.length - 1];
      return f ? rgbToHex(f.rgb) : "#000000";
    });
    const accent = vivid.length > 1 ? rgbToHex(vivid[1].rgb) : neon[0];
    return { neon, accent };
  }

  function ensureGrain(w: number, h: number) {
    if (grainCanvas && grainCanvas.width === w && grainCanvas.height === h) {
      return grainCanvas;
    }
    grainCanvas = document.createElement("canvas");
    grainCanvas.width = w;
    grainCanvas.height = h;
    const gctx = grainCanvas.getContext("2d")!;
    const img = gctx.createImageData(w, h);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = 128 + (Math.random() - 0.5) * 140;
      img.data[i] = v;
      img.data[i + 1] = v;
      img.data[i + 2] = v;
      img.data[i + 3] = 255;
    }
    gctx.putImageData(img, 0, 0);
    return grainCanvas;
  }

  function render(t: number) {
    if (!canvas || !ctx || !cfg) return;
    const w = canvas.width;
    const h = canvas.height;

    if (!tiny) {
      tiny = document.createElement("canvas");
      tiny.width = GRID_W;
      tiny.height = GRID_H;
      tinyCtx = tiny.getContext("2d")!;
    }
    const raw = sampleGrid(cfg, t, GRID_W, GRID_H);
    tinyCtx!.putImageData(new ImageData(new Uint8ClampedArray(raw), GRID_W, GRID_H), 0, 0);

    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.clearRect(0, 0, w, h);
    ctx.filter = "blur(2px)";
    ctx.drawImage(tiny, 0, 0, GRID_W, GRID_H, 0, 0, w, h);
    ctx.filter = "none";

    ctx.globalAlpha = 0.05;
    ctx.globalCompositeOperation = "overlay";
    ctx.drawImage(ensureGrain(w, h), 0, 0);
    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = "source-over";
  }

  function stopLoop() {
    if (rafId != null) {
      cancelAnimationFrame(rafId);
      rafId = null;
    }
  }

  function updateLoop() {
    const active =
      !reducedMotion && heroVisible && !document.hidden && root != null;
    if (active) {
      if (rafId == null) {
        rafId = requestAnimationFrame(frame);
      }
    } else {
      stopLoop();
    }
  }

  function sizeCanvas() {
    if (!canvas || !cfg || !root) return;
    const img = root.querySelector<HTMLImageElement>(".hero-art-img");
    const cssWidth = img ? img.offsetWidth : 1920;
    const cssHeight = img && img.offsetHeight
      ? img.offsetHeight
      : Math.round(cssWidth * (1080 / 1920));
    canvas.style.width = `${cssWidth}px`;
    canvas.style.height = `${cssHeight}px`;
    canvas.width = cssWidth;
    canvas.height = cssHeight;
    if (renderer3d) {
      const canvas3d = root.querySelector<HTMLCanvasElement>(".hero-art-canvas3d");
      if (canvas3d) {
        canvas3d.style.width = `${cssWidth}px`;
        canvas3d.style.height = `${cssHeight}px`;
        renderer3d.resize(cssWidth, cssHeight);
      }
    }
  }

  function frame(now: number) {
    const t = now / 1000;
    render(t);
    if (renderer3d) {
      renderer3d.render(t, window.scrollY);
    }
    if (root && !root.classList.contains("is-animated")) {
      root.classList.add("is-animated");
    }
    rafId = requestAnimationFrame(frame);
  }

  function initArt() {
    const next = document.querySelector<HTMLElement>(".hero-art");
    if (!next) {
      stopLoop();
      if (observer) {
        observer.disconnect();
        observer = null;
      }
      root = null;
      canvas = null;
      ctx = null;
      cfg = null;
      renderer3d = null;
      return;
    }
    if (next.dataset.bound) return;
    next.dataset.bound = "true";

    const rawSeed = next.getAttribute("data-art-seed");
    if (rawSeed == null) return;

    root = next;
    cfg = generateBankFields(Number(rawSeed), BANK, GRID_W, GRID_H);
    canvas = next.querySelector<HTMLCanvasElement>(".hero-art-canvas");
    ctx = canvas ? canvas.getContext("2d") : null;
    if (!canvas || !ctx) return;

    renderer3d = null;
    const canvas3d = next.querySelector<HTMLCanvasElement>(".hero-art-canvas3d");
    if (canvas3d) {
      const { neon, accent } = derive3dColors(cfg);
      renderer3d = createHero3D(canvas3d, neon, accent, 0.9);
    }

    if (observer) {
      observer.disconnect();
    }
    heroVisible = true;
    observer = new IntersectionObserver((entries) => {
      heroVisible = entries[0]?.isIntersecting ?? true;
      updateLoop();
    });
    const heroEl =
      next.querySelector<HTMLElement>(".hero-art-img") ?? next;
    observer.observe(heroEl);

    stopLoop();
    sizeCanvas();
    render(0);
    if (renderer3d) {
      renderer3d.render(0, window.scrollY);
    }
    root.classList.add("is-animated");
    updateLoop();
  }

  document.addEventListener("astro:page-load", initArt);
  document.addEventListener("visibilitychange", updateLoop);
  window.addEventListener("resize", () => {
    if (!root) return;
    sizeCanvas();
    render(0);
    if (renderer3d) {
      renderer3d.render(0, window.scrollY);
    }
  });

  initArt();
</script>

<style>
  .hero-art {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    z-index: -1;
    -webkit-mask-image: radial-gradient(
      ellipse 200% 120% at 40% 0%,
      #000 42%,
      rgba(0, 0, 0, 0.7) 58%,
      rgba(0, 0, 0, 0.35) 70%,
      rgba(0, 0, 0, 0.1) 78%,
      transparent 83%
    );
    mask-image: radial-gradient(
      ellipse 200% 120% at 40% 0%,
      #000 42%,
      rgba(0, 0, 0, 0.7) 58%,
      rgba(0, 0, 0, 0.35) 70%,
      rgba(0, 0, 0, 0.1) 78%,
      transparent 83%
    );
  }

  @media (max-width: 630px) {
    .hero-art {
      aspect-ratio: 10 / 13;
    }
  }

  @media (max-width: 930px) and (min-width: 631px) {
    .hero-art {
      min-height: 34rem;
    }
  }

  .hero-art-img,
  .hero-art-canvas,
  .hero-art-canvas3d {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scale(1.12);
  }

  .hero-art-img {
    object-fit: cover;
    opacity: 1;
    transition: opacity 2s ease;
  }

  .hero-art-canvas3d {
    -webkit-filter: blur(6px) saturate(1.4);
    filter: blur(6px) saturate(1.4);
    mix-blend-mode: plus-lighter;
  }

  .hero-art-canvas,
  .hero-art-canvas3d {
    opacity: 0;
    transition: opacity 2s ease;
  }

  .hero-art.is-animated .hero-art-img {
    opacity: 0;
  }

  .hero-art.is-animated .hero-art-canvas,
  .hero-art.is-animated .hero-art-canvas3d {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art-img,
    .hero-art-canvas,
    .hero-art-canvas3d {
      transition: none;
    }
  }
</style>
