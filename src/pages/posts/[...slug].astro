---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import HeroArt from "../../components/HeroArt.astro";
import SectionIndicator from "../../components/SectionIndicator.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("posts");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const heroAlt = entry.data.imageAlt ?? entry.data.title;
const wordCount = entry.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));
const pubDate = entry.data.pubDate;
---

<Layout
  title={entry.data.title}
  image={{ src: `${base}generated/art/${entry.slug}.png`, alt: heroAlt }}
>
  <SectionIndicator />

  <HeroArt
    slug={entry.slug}
    alt=""
    seed={entry.data.seed}
  />

  <header class="article-header">
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
    <div class="meta">
      <span>{entry.data.author}</span>
      <span class="sep" aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>{pubDate.toDateString()}</time>
      <span class="sep" aria-hidden="true">·</span>
      <span>{readingTime} min read</span>
    </div>
    <ul class="tags">
      {entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </header>

  <div id="article-content">
    <button
      id="toggle-hide-side-mobile"
      type="button"
      aria-controls="article-aside"
      aria-expanded="false"
    >
      table of contents
    </button>
    <aside id="article-aside">
      <TableOfContents headings={headings} />
    </aside>
    <main id="main-wrapper" class="wrapper article">
      <Content />
    </main>
  </div>
</Layout>

<style>
  .article-header {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin: 0 auto;
    padding: 8rem 1.5rem 6rem;
    text-align: center;
  }

  .article-header::before {
    content: "";
    position: absolute;
    inset: -4rem 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 55% 62% at 50% 42%,
      rgb(0 0 0 / 0.4),
      transparent 72%
    );
    pointer-events: none;
  }

  .article-header h1 {
    margin: 0;
    color: #fff;
    font-size: var(--text-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 28px rgb(0 0 0 / 0.4);
  }

  .article-header .lede {
    margin: 1.25rem auto 0;
    max-width: 36rem;
    color: rgb(255 255 255 / 0.9);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 300;
  }

  .article-header .meta {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    column-gap: 0.6rem;
    row-gap: 0.25rem;
    color: rgb(255 255 255 / 0.72);
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-sm);
  }

  .article-header .meta .sep {
    opacity: 0.5;
  }

  .article-header .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .article-header .tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-xs);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.4);
    color: rgb(255 255 255 / 0.9);
    background: rgb(255 255 255 / 0.12);
  }

  #article-content {
    display: grid;
    grid-template-columns: minmax(0, 56ch) 15rem;
    column-gap: 4rem;
    justify-content: center;
    margin: 0 auto;
    padding: 2rem 1.5rem 12rem;
    align-items: start;

    @media (max-width: 930px) {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 6rem;
    }
  }

  #main-wrapper {
    grid-column: 1;
    grid-row: 1;
    max-width: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    line-height: 1.65;

    h2 {
      margin-top: 3rem;
    }

    h3 {
      margin-top: 2.4rem;
    }

    p {
      margin-top: 1.5rem;
    }

    p a {
      color: var(--color-accent);
    }
  }

  #main-wrapper :global(img) {
    height: auto !important;
    width: 100%;
    margin-top: 2.2rem;
  }

  body > main.article > figure > figcaption > p {
    margin-top: 0.5rem;
    font-size: var(--text-xs);
  }

  #article-aside {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  #article-aside::-webkit-scrollbar {
    display: none;
  }

  #toggle-hide-side-mobile {
    grid-column: 1 / -1;
    display: none;
    background: var(--color-accent-strong);
    border: none;
    color: var(--color-on-accent);
    height: 42px;
    width: 100%;
    border-radius: 0.5rem;
    padding: 0;
    font-size: var(--text-sm);
    cursor: pointer;
    margin: 0 0 1.5rem;
  }

  @media (max-width: 930px) {
    #toggle-hide-side-mobile {
      display: inline-block;
      grid-column: 1;
      grid-row: 1;
    }

    #article-aside {
      grid-column: 1;
      grid-row: 2;
      display: none;
      position: static;
      top: 0;
      max-height: none;
      overflow: visible;
      margin-top: 1.5rem;
    }

    #article-aside.open {
      display: block;
    }

    #main-wrapper {
      grid-column: 1;
      grid-row: 3;
    }
  }

  @media (max-width: 630px) {
    .article-header {
      padding: 5rem 1.25rem 3rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // hack to add the css-grid full-bleed style to images in the rendered markdown content
    var mainWrapper = document.querySelector("main.wrapper");
    if (mainWrapper) {
      var paragraphs = mainWrapper.querySelectorAll("p");
      paragraphs.forEach(function (paragraph) {
        if (paragraph.getElementsByTagName("img").length === 1) {
          paragraph.style.width = "100%";
          paragraph.style.gridColumn = "1 / 4";
        }
      });
    }

    const mobileButton = document.getElementById("toggle-hide-side-mobile");
    const aside = document.getElementById("article-aside");

    if (mobileButton && aside) {
      const update = () => {
        const open = aside.classList.contains("open");
        mobileButton.textContent = open
          ? "hide table of contents"
          : "table of contents";
        mobileButton.setAttribute("aria-expanded", String(open));
      };

      mobileButton.addEventListener("click", () => {
        aside.classList.toggle("open");
        update();
      });

      update();
    }
  });
</script>
