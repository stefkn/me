---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import stefanImage from "../assets/stefan.jpg";
import cvImage from "../assets/cv.png";
import enkiLogo from "../assets/enki_logo.jpg";
import tailsLogo from "../assets/tails_logo.png";
import krakenLogo from "../assets/krakentech_logo.svg";
import tentacleImage from "../assets/tentacle-xl.png";
import kclLogo from "../assets/kcl_logo.svg";
import milkfeedAppImage from "../assets/milkfeed-app.png";
import milkfeedNightModeImage from "../assets/milkfeed-nightmode.png";
import milkfeedSharedSessionImage from "../assets/milkfeed-shared-session.png";
import perspectiveDesktopImage from "../assets/perspective-desktop.png";
import perspectiveMobileImage from "../assets/perspective-mobile.png";

import {
	programmingLanguages,
	webTechnologies,
	devopsInfra,
	databases,
	testing,
	otherTechnologies,
	krakenStack,
	tailsStack,
	enkiStack,
	kclStack,
} from "../content/technologies";

const pageTitle = "Résumé/CV";
---

<Layout title={pageTitle}>
	<div>
		<Image
			src={stefanImage}
			alt="A picture of Stefan Nowak"
			class="full-bleed work-intro-image"
			onload="this.style.opacity=1; this.style.filter='saturate(1.05)'"
			quality="mid"
		/>
	</div>
	<section id="top-content">
		<h1 id="page-title" class="animated">work</h1>
		<div class="cv-container">
			<Image
				src={cvImage}
				alt="A picture of my CV"
				class="cv-image"
				onload="this.style.opacity=1; this.style.filter='saturate(1.05)'"
				quality="low"
				onclick=`window.location="https://docs.google.com/presentation/d/17DqKnTw6O60B9ycDUaiPnrLB5iLsREHoJxvHP7KKiA4/edit?usp=sharing"`
			/>
			<a
				href="https://docs.google.com/presentation/d/17DqKnTw6O60B9ycDUaiPnrLB5iLsREHoJxvHP7KKiA4/edit?usp=sharing"
			>
				view my CV here
			</a>
		</div>
	</section>
	<main class="wrapper grid">
		<section>
			<h2 class="animated">tl;dr</h2>
			<p>
				I enjoy learning, building cool things and working together with kind, good 
				people.
			</p>

			<h2>about me</h2>
			<p>
				I'm Stefan, a developer/software engineer in London, England 🇬🇧
			</p>
			<p>
				Like many in tech, I've been tinkering with computers since I was a child
				<sup><a href="#footnote-1" id="footnote-ref-1">1</a></sup>, and
				I enjoy building things that make people's lives easier, more
				fun, or just more interesting.
			</p>
			<p>
				I've worked a lot in backend web development, but I also do some
				frontend from time to time. I have also occasionally managed small teams, 
				worked directly with external clients, mentored junior colleagues and have helped to grow teams, too. 
			</p>
			<p>
				While the web is where I work most, I'm also interested in DevOps, 
				security, systems programming, SRE and infrastructure. I also find retro 
				computing and the history of computing and computers/science/CS very cool. 
			</p>
			<p id="footnote-1">
				<sup>1</sup> Windows 95 had the best <a href="https://www.youtube.com/watch?v=I3Ak5VgyEoc">Brian Eno</a> sounds. <a href="#footnote-ref-1" aria-label="Back to footnote reference">^</a>
			</p>

			<h2>timeline</h2>
			<div class="timeline">
				<div class="timeline-entry">
					<div class="flex">
						<div class="kraken-logo-wrap">
							<Image
								src={krakenLogo}
								alt="Kraken Technologies logo"
								class="kraken-logo"
								width="100"
								height="100"
							/>
							<Image
								src={tentacleImage}
								alt=""
								class="kraken-tentacle"
								width="50"
								height="50"
							/>
						</div>
						<div class="timeline-details">
							<h3>2024 - today</h3>
							<strong>Backend Software Engineer</strong>
							<p>
								<a href="https://kraken.tech"
									>Kraken Technologies</a
								>
							</p>
						</div>
					</div>
					<div class="stack">
						{
							krakenStack.map((tech) => (
								<li>
									<Icon
										name={tech.icon}
										size={50}
										style="margin-bottom: 0.25rem; margin: auto;"
									/>{" "}
									{tech.name}
								</li>
							))
						}
					</div>
					<p>
						<i>The advanced operating system for utilities.</i>
					</p>
				</div>
				<div class="timeline-entry">
					<div class="flex">
						<Image
							src={tailsLogo}
							alt="Tails.com logo"
							class="tails-logo"
							width="100"
							height="100"
						/>
						<div class="timeline-details">
							<h3>2019 - 2024</h3>
							<strong
								>Backend / Full-stack Software Engineer</strong
							>
							<p>
								<a href="https://www.tails.com">tails.com</a>
							</p>
						</div>
					</div>
					<div class="stack">
						{
							tailsStack.map((tech) => (
								<li>
									<Icon
										name={tech.icon}
										size={50}
										style="margin-bottom: 0.25rem; margin: auto;"
									/>{" "}
									{tech.name}
								</li>
							))
						}
					</div>
					<p>
						<i>Individually-bespoke, tailored nutrition for dogs.</i>
					</p>
					<p>
						I helped build a new frontend app in Vue, created the BfF
						backend for it, and worked on the backend generally, as well
						as updating the internal CRM/ERP platform, integrating new
						APIs and microservices, adding new features and AB tests
						to their Vue apps and the monolithic Flask app. I made some
						lifelong friends (human and canine) and learned a lot about
						dogs. I also discovered <a
							href="https://www.thewhitecrossrichmond.com/the-pub-that-floods/"
							>a pub in Richmond</a
						> that floods when the river Thames gets too high, which
						is often.
					</p>
				</div>
				<div class="timeline-entry">
					<div class="flex">
						<Image
							src={enkiLogo}
							alt="Enki Labs logo"
							class="enki-logo"
							width="100"
							height="100"
						/>
						<div class="timeline-details">
							<h3>2017 - 2018</h3>
							<strong>Freelance Contractor</strong>
							<p>
								<a href="https://www.enki.com/"
									>Enki Labs. Inc.</a
								>
							</p>
						</div>
					</div>
					<div class="stack">
						{
							enkiStack.map((tech) => (
								<li>
									<Icon
										name={tech.icon}
										size={50}
										style="margin-bottom: 0.25rem; margin: auto;"
									/>{" "}
									{tech.name}
								</li>
							))
						}
					</div>
					<p>
						<i>The AI-powered 1:1 skills coach for top performers.</i>
					</p>
					<p>
						I worked with Enki to contribute to their Advanced Python
						course content, QA their TestFlight builds, troubleshoot
						the app, MongoDB instance and billing jobs as well as helping
						to improve their CX and UX. Additionally, I discovered <a
							href="https://www.gigsfishandchips.com/"
							>the best fish and chips</a
						> in Goodge Street, and that Țuică is dangerous.
					</p>
				</div>
				<div class="timeline-entry">
					<div class="flex">
						<Image
							src={kclLogo}
							alt="King's College London logo"
							class="kcl-logo"
							width="100"
							height="100"
						/>
						<div class="timeline-details">
							<h3>2015 - 2019</h3>
							<strong>MSc.(i) (Hons.) Computer Science</strong>
							<p>
								<a
									href="https://www.kcl.ac.uk/study/undergraduate/courses/computer-science-msci"
									>King's College London</a
								>
							</p>
						</div>
					</div>
					<div class="stack">
						{
							kclStack.map((tech) => (
								<li>
									<Icon
										name={tech.icon}
										size={50}
										style="margin-bottom: 0.25rem; margin: auto;"
									/>{" "}
									{tech.name}
								</li>
							))
						}
					</div>
					<p>
						<i>A four-year integrated master's degree in the heart of London.</i>
					</p>
					<p>
						I learned a dizzying amount about computing, logic and mathematics,
						how to complete an entire term's worth of work in a single
						night, and how many energy drinks it takes to stay awake
						for 48 hours. I also learned to hate <a
							href="https://github.com/EnterpriseQualityCoding/FizzBuzzEnterpriseEdition/blob/uinverse/src/main/java/com/seriouscompany/business/java/fizzbuzz/packagenamingpackage/impl/math/arithmetics/NumberIsMultipleOfAnotherNumberVerifier.java"
							>Java</a
						>.
					</p>
				</div>
			</div>
		</section>
		<section>
			<h2 class="animated">skills</h2>
			<p>
				I'm a big believer that it doesn't really matter what specific
				technologies you "know" – what's more important is an enthusiasm
				for learning new things, a good understanding of CS fundamentals, 
				and the ability to keep trying until you get it. 
				Being kind and empathetic, and not being afraid to ask
				for help, are also key.
			</p>
			<p>
				That said, here are some of the technologies I've worked with
				over the years, in no particular order.
			</p>
			<h3>Programming languages</h3>
			<ul class="skills-icons">
				{
					programmingLanguages.map((tech) => (
						<li>
							<Icon
								name={tech.icon}
								size={50}
								style="margin-bottom: 0.25rem; margin: auto;"
							/>{" "}
							{tech.name}
						</li>
					))
				}
			</ul>
			<h3>Web Technologies</h3>
			<ul class="skills-icons">
				{
					webTechnologies.map((tech) => (
						<li>
							<Icon
								name={tech.icon}
								size={50}
								style="margin-bottom: 0.25rem; margin: auto;"
							/>{" "}
							{tech.name}
						</li>
					))
				}
			</ul>
			<h3>DevOps and Infrastructure</h3>
			<ul class="skills-icons">
				{
					devopsInfra.map((tech) => (
						<li>
							<Icon
								name={tech.icon}
								size={50}
								style="margin-bottom: 0.25rem; margin: auto;"
							/>{" "}
							{tech.name}
						</li>
					))
				}
			</ul>
			<h3>Databases</h3>
			<ul class="skills-icons">
				{
					databases.map((tech) => (
						<li>
							<Icon
								name={tech.icon}
								size={50}
								style="margin-bottom: 0.25rem; margin: auto;"
							/>{" "}
							{tech.name}
						</li>
					))
				}
			</ul>
			<h3>Testing and QA</h3>
			<ul class="skills-icons">
				{
					testing.map((tech) => (
						<li>
							<Icon
								name={tech.icon}
								size={50}
								style="margin-bottom: 0.25rem; margin: auto;"
							/>{" "}
							{tech.name}
						</li>
					))
				}
			</ul>
			<h3>Other stuff</h3>
			<ul class="skills-icons">
				{
					otherTechnologies.map((tech) => (
						<li>
							<Icon
								name={tech.icon}
								size={50}
								style="margin-bottom: 0.25rem; margin: auto;"
							/>{" "}
							{tech.name}
						</li>
					))
				}
			</ul>
		</section>
		<section>
			<h2 class="animated">side projects</h2>
			<h3>milkfeed</h3>
			<p>
				A minimalistic baby feed-tracking app.
			</p>
			<div class="project-screenshots">
				<button class="project-screenshot-button" type="button">
					<Image
						src={milkfeedAppImage}
						alt="Milkfeed feed-tracking dashboard"
					/>
				</button>
				<button class="project-screenshot-button" type="button">
					<Image
						src={milkfeedNightModeImage}
						alt="Milkfeed dashboard in night mode"
					/>
				</button>
				<button class="project-screenshot-button" type="button">
					<Image
						src={milkfeedSharedSessionImage}
						alt="Milkfeed shared-session invitation screen"
					/>
				</button>
			</div>
			<h3>perspective</h3>
			<p>
				A simple timeline for putting historical events in perspective.
			</p>
			<div class="project-screenshots project-screenshots--perspective">
				<button class="project-screenshot-button" type="button">
					<Image
						src={perspectiveDesktopImage}
						alt="Perspective timeline on a desktop display"
					/>
				</button>
				<button class="project-screenshot-button" type="button">
					<Image
						src={perspectiveMobileImage}
						alt="Perspective timeline on a mobile display"
					/>
				</button>
			</div>
			<h3>genetictactoe</h3>
			<p>
				Naughts and Crosses, using genetic algorithms. 
			</p>
			<h2>other skills</h2>
			<h3>Fluent conversational Japanese</h3>
			<p>
				I am, as they say, <i>nihongo jõzu.</i>
			</p>
			<h3>lifting heavy objects, repetitively</h3>
			<p>
				Moving bits and bytes? Easy. 
			</p>
			<p>
				Moving atoms? <i>Now we're talking.</i>
			</p>
		</section>
	</main>
	<dialog class="screenshot-dialog" aria-label="Expanded project screenshot">
		<button class="screenshot-dialog-close" type="button" aria-label="Close image">
			Close
		</button>
		<img class="screenshot-dialog-image" alt="" />
	</dialog>
</Layout>

<script>
	import { inView, animate } from "motion";

	function setupAnimations() {
		inView("section", ({ target }) => {
			if (target.querySelector(".animated")) {
				animate(
					// @ts-ignore
					target.querySelector(".animated"),
					{ opacity: 1, transform: "none" },
					{
						delay: 0.2,
						duration: 0.8,
						easing: [0.17, 0.55, 0.55, 1],
					},
				);
			}
		});
	}

	// hook animations up to View Transitions via after-swap lifecycle hook
	document.addEventListener("astro:page-load", () => {
		setupAnimations();
	});

	setupAnimations();

	function setupScreenshotZoom() {
		const dialog = document.querySelector<HTMLDialogElement>(".screenshot-dialog");
		const dialogImage = dialog?.querySelector<HTMLImageElement>(".screenshot-dialog-image");
		const closeButton = dialog?.querySelector<HTMLButtonElement>(".screenshot-dialog-close");

		if (!dialog || !dialogImage || !closeButton) return;

		document.querySelectorAll<HTMLButtonElement>(".project-screenshot-button").forEach((button) => {
			button.onclick = () => {
				const image = button.querySelector<HTMLImageElement>("img");
				if (!image) return;

				dialogImage.src = image.currentSrc || image.src;
				dialogImage.alt = image.alt;
				dialog.showModal();
			};
		});

		closeButton.onclick = () => dialog.close();
		dialog.onclick = ({ target }) => {
			if (target === dialog) dialog.close();
		};
	}

	document.addEventListener("astro:page-load", setupScreenshotZoom);
	setupScreenshotZoom();
</script>

<style>
	#top-content {
		border: none;
	}
	.cv-container {
		display: flex;
		align-items: center;
		max-width: 750px;
		margin: auto;
		padding: 1.5rem;
		margin-top: 2.2rem;
	}
	.cv-container > a {
