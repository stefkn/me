---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import stefanImage from "../assets/stefan.jpg";
import cvImage from "../assets/cv.png";
import enkiLogo from "../assets/enki_logo.jpg";
import tailsLogo from "../assets/tails_logo.png";
import krakenLogo from "../assets/krakentech_logo.svg";
import tentacleImage from "../assets/tentacle-xl.png";
import kclLogo from "../assets/kcl_logo.svg";
import milkfeedAppImage from "../assets/milkfeed-app.png";
import milkfeedNightModeImage from "../assets/milkfeed-nightmode.png";
import milkfeedSharedSessionImage from "../assets/milkfeed-shared-session.png";
import perspectiveDesktopImage from "../assets/perspective-desktop.png";
import perspectiveMobileImage from "../assets/perspective-mobile.png";

import {
	programmingLanguages,
	webTechnologies,
	devopsInfra,
	databases,
	testing,
	otherTechnologies,
	krakenStack,
	tailsStack,
	enkiStack,
	kclStack,
} from "../content/technologies";

const pageTitle = "Work";
const cvUrl =
	"https://docs.google.com/presentation/d/17DqKnTw6O60B9ycDUaiPnrLB5iLsREHoJxvHP7KKiA4/edit?usp=sharing";

const skills = [
	{ label: "Programming languages", items: programmingLanguages },
	{ label: "Web technologies", items: webTechnologies },
	{ label: "DevOps & infrastructure", items: devopsInfra },
	{ label: "Databases", items: databases },
	{ label: "Testing & QA", items: testing },
	{ label: "Other stuff", items: otherTechnologies },
];
---

<Layout title={pageTitle}>
	<div class="work-bg" aria-hidden="true">
		<span class="glow glow-1"></span>
		<span class="glow glow-2"></span>
		<span class="glow glow-3"></span>
		<span class="dot-grid"></span>
	</div>

	<div class="work-wrap">
		<header class="hero reveal">
			<div class="hero-media">
				<Image
					src={stefanImage}
					alt="A picture of Stefan Nowak"
					class="hero-portrait"
					quality="mid"
				/>
				<a class="cv-card" href={cvUrl} aria-label="View my CV">
					<Image
						src={cvImage}
						alt="Preview of my CV"
						class="cv-thumb"
						quality="low"
					/>
					<span class="cv-card-label">cv ↗</span>
				</a>
				<span class="hero-media-frame" aria-hidden="true"></span>
			</div>
			<div class="hero-copy">
				<p class="eyebrow">software engineer · london, uk</p>
				<h1 class="hero-title">Stefan Nowak</h1>
				<p class="hero-lede">
					I build backend systems, small tools and the occasional
					frontend — with a soft spot for the history of computers,
					systems programming and anything that makes people's days a
					little easier.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href={cvUrl}>view cv</a>
					<a class="btn btn-ghost" href="https://github.com/stefkn">github</a>
				</div>
			</div>
		</header>

		<section class="work-section reveal" id="about">
			<div class="section-head">
				<span class="section-num">01</span>
				<h2>about</h2>
			</div>
			<div class="prose">
				<p class="lede">
					I enjoy learning, building cool things and working together
					with kind, good people.
				</p>
				<p>
					Like many in tech, I've been tinkering with computers since
					I was a child<sup><a href="#footnote-1" id="footnote-ref-1">1</a></sup>,
					and I enjoy building things that make people's lives easier,
					more fun, or just more interesting.
				</p>
				<p>
					I've worked a lot in backend web development, but I also do
					some frontend from time to time. I have also occasionally
					managed small teams, worked directly with external clients,
					mentored junior colleagues and helped grow teams, too.
				</p>
				<p>
					While the web is where I work most, I'm also interested in
					DevOps, security, systems programming, SRE and
					infrastructure. I also find retro computing and the history
					of computing very cool.
				</p>
				<p id="footnote-1" class="footnote">
					<sup>1</sup> Windows 95 had the best <a href="https://www.youtube.com/watch?v=I3Ak5VgyEoc">Brian Eno</a> sounds. <a href="#footnote-ref-1" aria-label="Back to footnote reference">^</a>
				</p>
			</div>
		</section>

		<section class="work-section reveal" id="experience">
			<div class="section-head">
				<span class="section-num">02</span>
				<h2>experience</h2>
			</div>

			<div class="timeline">
				<article class="timeline-item">
					<div class="timeline-card">
						<div class="tl-head">
							<div class="tl-logo kraken-logo-wrap">
								<Image src={krakenLogo} alt="Kraken Technologies logo" class="kraken-logo" width="100" height="100" />
								<Image src={tentacleImage} alt="" class="kraken-tentacle" width="50" height="50" />
							</div>
							<div class="tl-title">
								<span class="tl-period">2024 — today</span>
								<h3>Backend Software Engineer</h3>
								<p class="tl-company">
									<a href="https://kraken.tech">Kraken Technologies</a>
								</p>
							</div>
						</div>
						<p class="tl-desc">
							<i>The advanced operating system for utilities.</i>
						</p>
						<p class="tl-desc">
							Building the platform that powers energy suppliers and
							water utilities across the world — working across
							backend services, integrations and internal tooling.
						</p>
						<ul class="chips">
							{krakenStack.map((tech) => (
								<li class="chip">
									<Icon name={tech.icon} size={18} />
									<span>{tech.name}</span>
								</li>
							))}
						</ul>
					</div>
				</article>

				<article class="timeline-item">
					<div class="timeline-card">
						<div class="tl-head">
							<div class="tl-logo tl-logo--tails">
								<Image src={tailsLogo} alt="tails.com logo" class="tl-logo-img tails-logo" width="100" height="100" />
							</div>
							<div class="tl-title">
								<span class="tl-period">2019 — 2024</span>
								<h3>Backend / Full-stack Software Engineer</h3>
								<p class="tl-company">
									<a href="https://www.tails.com">tails.com</a>
								</p>
							</div>
						</div>
						<p class="tl-desc">
							<i>Individually-bespoke, tailored nutrition for dogs.</i>
						</p>
						<p class="tl-desc">
							I helped build a new frontend app in Vue, created the
							BfF backend for it, and worked on the backend
							generally, as well as updating the internal CRM/ERP
							platform, integrating new APIs and microservices,
							adding new features and AB tests to their Vue apps
							and the monolithic Flask app. I made some lifelong
							friends (human and canine) and learned a lot about
							dogs. I also discovered <a href="https://www.thewhitecrossrichmond.com/the-pub-that-floods/">a pub in Richmond</a> that floods when the river Thames gets too high, which is often.
						</p>
						<ul class="chips">
							{tailsStack.map((tech) => (
								<li class="chip">
									<Icon name={tech.icon} size={18} />
									<span>{tech.name}</span>
								</li>
							))}
						</ul>
					</div>
				</article>

				<article class="timeline-item">
					<div class="timeline-card">
						<div class="tl-head">
							<div class="tl-logo tl-logo--enki">
								<Image src={enkiLogo} alt="Enki Labs logo" class="tl-logo-img enki-logo" width="100" height="100" />
							</div>
							<div class="tl-title">
								<span class="tl-period">2017 — 2018</span>
								<h3>Freelance Contractor</h3>
								<p class="tl-company">
									<a href="https://www.enki.com/">Enki Labs. Inc.</a>
								</p>
							</div>
						</div>
						<p class="tl-desc">
							<i>The AI-powered 1:1 skills coach for top performers.</i>
						</p>
						<p class="tl-desc">
							I worked with Enki to contribute to their Advanced
							Python course content, QA their TestFlight builds,
							troubleshoot the app, MongoDB instance and billing
							jobs as well as helping to improve their CX and UX.
							Additionally, I discovered <a href="https://www.gigsfishandchips.com/">the best fish and chips</a> in Goodge Street, and that Țuică is dangerous.
						</p>
						<ul class="chips">
							{enkiStack.map((tech) => (
								<li class="chip">
									<Icon name={tech.icon} size={18} />
									<span>{tech.name}</span>
								</li>
							))}
						</ul>
					</div>
				</article>

				<article class="timeline-item">
					<div class="timeline-card">
						<div class="tl-head">
							<div class="tl-logo tl-logo--kcl">
								<Image src={kclLogo} alt="King's College London logo" class="tl-logo-img kcl-logo" width="100" height="100" />
							</div>
							<div class="tl-title">
								<span class="tl-period">2015 — 2019</span>
								<h3>MSc.(i) (Hons.) Computer Science</h3>
								<p class="tl-company">
									<a href="https://www.kcl.ac.uk/study/undergraduate/courses/computer-science-msci">King's College London</a>
								</p>
							</div>
						</div>
						<p class="tl-desc">
							<i>A four-year integrated master's degree in the heart of London.</i>
						</p>
						<p class="tl-desc">
							I learned a dizzying amount about computing, logic and
							mathematics, how to complete an entire term's worth of
							work in a single night, and how many energy drinks it
							takes to stay awake for 48 hours. I also learned to
							hate <a href="https://github.com/EnterpriseQualityCoding/FizzBuzzEnterpriseEdition/blob/uinverse/src/main/java/com/seriouscompany/business/java/fizzbuzz/packagenamingpackage/impl/math/arithmetics/NumberIsMultipleOfAnotherNumberVerifier.java">Java</a>.
						</p>
						<ul class="chips">
							{kclStack.map((tech) => (
								<li class="chip">
									<Icon name={tech.icon} size={18} />
									<span>{tech.name}</span>
								</li>
							))}
						</ul>
					</div>
				</article>
			</div>
		</section>

		<section class="work-section reveal" id="skills">
			<div class="section-head">
				<span class="section-num">03</span>
				<h2>skills</h2>
			</div>
			<p class="section-intro">
				It doesn't really matter which technologies you "know" — what
				counts is an enthusiasm for learning new things, a good grasp of
				CS fundamentals, and the patience to keep trying until it works.
				That said, here's some of the stuff I've used over the years:
			</p>
			<div class="skill-groups">
				{skills.map((group) => (
					<div class="skill-group">
						<h3>{group.label}</h3>
						<ul class="chips">
							{group.items.map((tech) => (
								<li class="chip">
									<Icon name={tech.icon} size={18} />
									<span>{tech.name}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</section>

		<section class="work-section reveal" id="projects">
			<div class="section-head">
				<span class="section-num">04</span>
				<h2>side projects</h2>
			</div>

			<div class="projects">
				<article class="project-card">
					<div class="project-copy">
						<h3>milkfeed</h3>
						<p>A minimalistic baby feed-tracking app.</p>
					</div>
					<div class="project-screenshots">
						<button class="project-screenshot-button" type="button">
							<Image src={milkfeedAppImage} alt="Milkfeed feed-tracking dashboard" />
						</button>
						<button class="project-screenshot-button" type="button">
							<Image src={milkfeedNightModeImage} alt="Milkfeed dashboard in night mode" />
						</button>
						<button class="project-screenshot-button" type="button">
							<Image src={milkfeedSharedSessionImage} alt="Milkfeed shared-session invitation screen" />
						</button>
					</div>
				</article>

				<article class="project-card">
					<div class="project-copy">
						<h3>perspective</h3>
						<p>A simple timeline for putting historical events in perspective.</p>
					</div>
					<div class="project-screenshots project-screenshots--perspective">
						<button class="project-screenshot-button" type="button">
							<Image src={perspectiveDesktopImage} alt="Perspective timeline on a desktop display" />
						</button>
						<button class="project-screenshot-button" type="button">
							<Image src={perspectiveMobileImage} alt="Perspective timeline on a mobile display" />
						</button>
					</div>
				</article>

				<article class="project-card">
					<div class="project-copy">
						<h3>genetictactoe</h3>
						<p>Naughts and Crosses, using genetic algorithms.</p>
					</div>
				</article>
			</div>
		</section>

		<section class="work-section reveal" id="other-skills">
			<div class="section-head">
				<span class="section-num">05</span>
				<h2>other skills</h2>
			</div>
			<div class="extras">
				<div class="extra">
					<h3>Fluent conversational Japanese</h3>
					<p>I am, as they say, <i>nihongo jõzu.</i></p>
				</div>
				<div class="extra">
					<h3>lifting heavy objects, repetitively</h3>
					<p>Moving bits and bytes? Easy. Moving atoms? <i>Now we're talking.</i></p>
				</div>
			</div>
		</section>
	</div>

	<dialog class="screenshot-dialog" aria-label="Expanded project screenshot">
		<button class="screenshot-dialog-close" type="button" aria-label="Close image">
			Close
		</button>
		<img class="screenshot-dialog-image" alt="" />
	</dialog>
</Layout>

<script>
	import { inView, animate } from "motion";

	function setupAnimations() {
		inView(".reveal", (info) => {
			animate(
				info.target,
				{ opacity: 1, transform: "none" },
				{
					delay: 0.1,
					duration: 0.8,
					easing: [0.17, 0.55, 0.55, 1],
				},
			);
		});
	}

	document.addEventListener("astro:page-load", () => {
		setupAnimations();
	});

	setupAnimations();

	function setupScreenshotZoom() {
		const dialog = document.querySelector<HTMLDialogElement>(".screenshot-dialog");
		const dialogImage = dialog?.querySelector<HTMLImageElement>(".screenshot-dialog-image");
		const closeButton = dialog?.querySelector<HTMLButtonElement>(".screenshot-dialog-close");

		if (!dialog || !dialogImage || !closeButton) return;

		document.querySelectorAll<HTMLButtonElement>(".project-screenshot-button").forEach((button) => {
			button.onclick = () => {
				const image = button.querySelector<HTMLImageElement>("img");
				if (!image) return;

				dialogImage.src = image.currentSrc || image.src;
				dialogImage.alt = image.alt;
				dialog.showModal();
			};
		});

		closeButton.onclick = () => dialog.close();
		dialog.onclick = ({ target }) => {
			if (target === dialog) dialog.close();
		};
	}

	document.addEventListener("astro:page-load", setupScreenshotZoom);
	setupScreenshotZoom();
</script>

<style>
	.work-bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	.glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(20px);
		will-change: transform;
	}

	.glow-1 {
		width: 46vw;
		height: 46vw;
		top: -14vw;
		right: -12vw;
		background: radial-gradient(
			circle at 38% 38%,
			rgb(83 97 255 / 0.14),
			rgb(83 97 255 / 0.05) 45%,
			transparent 70%
		);
		animation: glow-drift-a 30s ease-in-out infinite alternate;
	}

	.glow-2 {
		width: 40vw;
		height: 40vw;
		top: 32%;
		left: -16vw;
		background: radial-gradient(
			circle at 55% 50%,
			rgb(139 92 246 / 0.12),
			rgb(34 211 238 / 0.05) 50%,
			transparent 72%
		);
		animation: glow-drift-b 38s ease-in-out infinite alternate;
	}

	.glow-3 {
		width: 36vw;
		height: 36vw;
		bottom: -12vw;
		right: 6vw;
		background: radial-gradient(
			circle at 50% 50%,
			rgb(255 96 190 / 0.09),
			rgb(255 184 77 / 0.04) 50%,
			transparent 74%
		);
		animation: glow-drift-c 34s ease-in-out infinite alternate;
	}

	.dot-grid {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(var(--color-text) 1px, transparent 1.3px);
		background-size: 28px 28px;
		opacity: 0.05;
	}

	@keyframes glow-drift-a {
		from { transform: translate3d(0, 0, 0) scale(1); }
		to { transform: translate3d(-4vw, 5vh, 0) scale(1.15); }
	}

	@keyframes glow-drift-b {
		from { transform: translate3d(0, 0, 0) scale(1); }
		to { transform: translate3d(5vw, -4vh, 0) scale(1.1); }
	}

	@keyframes glow-drift-c {
		from { transform: translate3d(0, 0, 0) scale(1); }
		to { transform: translate3d(-3vw, -5vh, 0) scale(1.18); }
	}

	@media (prefers-reduced-motion: reduce) {
		.glow {
			animation: none;
		}
		.reveal {
			opacity: 1;
			transform: none;
		}
	}

	.reveal {
		opacity: 0;
		transform: translateY(18px);
	}

	.work-wrap {
		max-width: 68rem;
		margin: 0 auto;
		padding: 3rem 1.5rem 6rem;
	}

	/* ---------- hero ---------- */

	.hero {
		display: grid;
		grid-template-columns: minmax(240px, 340px) 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.hero-media {
		position: relative;
	}

	.hero-portrait {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 14px;
		border: 1px solid var(--color-border);
		box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.35);
	}

	.hero-media-frame {
		position: absolute;
		inset: 0;
		border-radius: 14px;
		pointer-events: none;
		transform: translate(14px, 14px);
		border: 1px solid var(--color-accent);
		opacity: 0.5;
		z-index: -1;
	}

	.cv-card {
		position: absolute;
		right: -2.75rem;
		bottom: -1.25rem;
		width: 118px;
		display: block;
		padding: 0.4rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 10px;
		box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.45);
		transform: rotate(3deg);
		transition: transform 0.2s ease;
		text-decoration: none;
	}

	.cv-card:hover {
		transform: rotate(0deg) translateY(-3px);
	}

	.cv-thumb {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 6px;
	}

	.cv-card-label {
		display: block;
		text-align: center;
		padding-top: 0.3rem;
		font-family: "IBM Plex Mono", monospace;
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.hero-copy {
		max-width: 40rem;
	}

	.eyebrow {
		font-family: "IBM Plex Mono", monospace;
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--color-accent-strong);
		margin: 0 0 0.75rem;
	}

	.hero-title {
		font-family: "IBM Plex Sans", sans-serif;
		font-weight: 500;
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1;
		letter-spacing: -0.035em;
		margin: 0 0 1.25rem;
	}

	.hero-lede {
		font-size: var(--text-lg);
		line-height: 1.4;
		color: var(--color-text-muted);
		margin: 0 0 1.75rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.7rem 1.5rem;
		border-radius: 999px;
		font-family: "IBM Plex Mono", monospace;
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-primary {
		background: var(--color-accent-strong);
		color: var(--color-on-accent);
		box-shadow: 0 12px 30px -12px rgb(0 22 255 / 0.6);
	}

	.btn-primary:hover {
		filter: brightness(1.08);
	}

	.btn-ghost {
		border: 1px solid var(--color-border);
		color: var(--color-text);
	}

	.btn-ghost:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	/* ---------- sections ---------- */

	.work-section {
		margin-top: clamp(4rem, 8vw, 7rem);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.section-num {
		font-family: "IBM Plex Mono", monospace;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-accent-strong);
	}

	.section-head h2 {
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: -0.03em;
		margin: 0;
	}

	.section-head::after {
		content: "";
		flex: 1;
		height: 1px;
		background: var(--color-border);
		align-self: center;
	}

	.section-intro {
		color: var(--color-text-muted);
		max-width: 46rem;
	}

	/* ---------- prose / about ---------- */

	.prose {
		max-width: 46rem;
	}

	.prose .lede {
		font-size: var(--text-lg);
		line-height: 1.45;
	}

	.prose p {
		margin-top: 1rem;
	}

	.footnote {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	/* ---------- timeline ---------- */

	.timeline {
