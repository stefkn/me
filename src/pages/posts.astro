---
import Layout from "../layouts/Layout.astro";
import PostCardImage from "../components/PostCardImage.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const allPosts = await getCollection("posts");
const byNewest = (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const sorted = [...allPosts].sort(byNewest);

const featured = sorted
  .filter((post) => post.data.featured)
  .sort(byNewest)[0];
const lead = featured ?? sorted[0];
const rest = sorted.filter((post) => post !== lead);

const pageTitle = "Blog posts";

const now = new Date();
const dateline = now.toLocaleDateString("en-GB", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const numberOfPosts = sorted.length;
const issueNumber = String(100 + sorted.length);
const volumeNumber = String(1 + now.getFullYear() - 2024);

const sectionOf = (post: CollectionEntry<"posts">) =>
  post.data.tags?.[0] ?? "dispatch";
const kickerOf = (post: CollectionEntry<"posts">) =>
  sectionOf(post).toUpperCase();

const postUrl = (slug: string) => `${base}posts/${slug}/`;
---

<Layout title={pageTitle}>
  <div class="posts-bg" aria-hidden="true">
    <span class="blob blob-1"></span>
    <span class="blob blob-2"></span>
    <span class="blob blob-3"></span>
    <span class="dots-overlay"></span>
  </div>

  <h1 class="sr-only">posts</h1>

  <div class="paper">
    <header class="masthead reveal">
      <div class="masthead-topline">
        <span>{dateline}</span>
        <span class="masthead-edition">
          vol. {volumeNumber} · no. {issueNumber}
        </span>
        <span>{numberOfPosts} articles</span>
      </div>
      <p class="masthead-title">the blog</p>
    </header>

    <div class="masthead-rule" aria-hidden="true"></div>

    <section class="lead-story reveal">
      <div class="lead-bg" aria-hidden="true">
        <PostCardImage post={lead} base={base} variant="hero" />
      </div>
      <div class="lead-text">
        <p class="kicker">lead story</p>
        <h2 class="headline">{lead.data.title}</h2>
        <p class="deck">{lead.data.description}</p>
        <p class="byline">
          <span class="byline-author">{lead.data.author}</span>
          <span class="byline-sep" aria-hidden="true">·</span>
          <time datetime={lead.data.pubDate.toISOString()}>
            {lead.data.pubDate.toDateString()}
          </time>
        </p>
        <ul class="tags">
          {lead.data.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      </div>
      <a class="card-link" href={postUrl(lead.slug)} aria-label={lead.data.title}></a>
    </section>

    <div class="section-rule" aria-hidden="true"></div>
    <p class="section-label reveal">more stuff:</p>

    <section class="news-grid">
      {
        rest.map((post) => (
          <article class="news-item reveal">
            <div class="news-card">
              <div class="news-bg" aria-hidden="true">
                <PostCardImage post={post} base={base} variant="hero" />
              </div>
              <div class="news-card-text">
                <p class="kicker">{kickerOf(post)}</p>
                <h3 class="headline">{post.data.title}</h3>
                <p class="deck">{post.data.description}</p>
                <p class="byline">
                  <span class="byline-author">{post.data.author}</span>
                  <span class="byline-sep" aria-hidden="true">·</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toDateString()}
                  </time>
                </p>
              </div>
              <a class="card-link" href={postUrl(post.slug)} aria-label={post.data.title}></a>
            </div>
          </article>
        ))
      }
    </section>
  </div>
</Layout>

<script>
  import { inView, animate } from "motion";

  function setupAnimations() {
    inView(".reveal", (info) => {
      animate(
        info.target,
        { opacity: 1, transform: "none" },
        {
          delay: 0.1,
          duration: 0.8,
          easing: [0.17, 0.55, 0.55, 1],
        },
      );
    });
  }

  document.addEventListener("astro:page-load", () => {
    setupAnimations();
  });

  setupAnimations();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
  }

  .paper {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
  }

  /* ---------- page background ---------- */

  .posts-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .blob-1 {
    width: 55vw;
    height: 55vw;
    top: -18vw;
    right: -18vw;
    background: radial-gradient(
      circle at 32% 32%,
      rgb(0 23 255 / 0.2),
      rgb(0 140 255 / 0.08) 45%,
      transparent 68%
    );
    animation: blob-drift-a 28s ease-in-out infinite alternate;
  }

  .blob-2 {
    width: 48vw;
    height: 48vw;
    bottom: -16vw;
    left: -14vw;
    background: radial-gradient(
      circle at 60% 55%,
      rgb(158 129 255 / 0.16),
      rgb(0 191 255 / 0.06) 48%,
      transparent 70%
    );
    animation: blob-drift-b 36s ease-in-out infinite alternate;
  }

  .blob-3 {
    width: 34vw;
    height: 34vw;
    top: 42%;
    left: 58%;
    background: radial-gradient(
      circle at 50% 50%,
      rgb(255 96 190 / 0.12),
      rgb(255 184 77 / 0.05) 50%,
      transparent 72%
    );
    animation: blob-drift-c 31s ease-in-out infinite alternate;
  }

  .dots-overlay {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--color-text) 1px, transparent 1.3px);
    background-size: 26px 26px;
    opacity: 0.07;
  }

  @keyframes blob-drift-a {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-5vw, 4vh, 0) scale(1.18); }
  }

  @keyframes blob-drift-b {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(4vw, -5vh, 0) scale(1.12); }
  }

  @keyframes blob-drift-c {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-3vw, 6vh, 0) scale(1.22); }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }

  @media (max-width: 620px) {
    .blob-1 { width: 80vw; height: 80vw; top: -30vw; right: -30vw; }
    .blob-2 { width: 70vw; height: 70vw; bottom: -25vw; left: -25vw; }
    .blob-3 { width: 55vw; height: 55vw; }
  }

  /* ---------- masthead ---------- */

  .masthead {
    text-align: center;
  }

  .masthead-topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .masthead-edition {
    color: var(--color-text);
  }

  .masthead-title {
    margin: 1.4rem 0 0.35rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.25rem, 9vw, 7rem);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .masthead-sub {
    margin: 0.25rem 0 0.4rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--color-text-muted);
  }

  .masthead-rule {
    border-top: 3px double var(--color-text);
    margin: 1.5rem 0 0;
  }

  /* ---------- shared type ---------- */

  .kicker {
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent-strong);
    margin: 0 0 0.6rem;
  }

  .headline {
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .deck {
    font-size: var(--text-base);
    line-height: 1.45;
    margin: 0.75rem 0 0;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0.9rem 0 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .byline-sep {
    opacity: 0.5;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
  }

  .tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  /* ---------- lead story ---------- */

  .lead-story {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-top: 2rem;
    min-height: clamp(24rem, 55vh, 36rem);
    border-radius: 8px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .lead-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .lead-bg :global(.post-index-hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lead-story::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(0 23 255 / 82%) 0%,
      rgb(0 0 0 / 0.38) 40%,
      rgb(0 0 0 / 0) 80%
    );
  }

  .lead-text {
    position: relative;
    z-index: 2;
    padding: clamp(1.5rem, 4vw, 3rem);
    max-width: 52rem;
    color: #fff;
  }

  .lead-text .headline {
    font-size: clamp(2.1rem, 4.6vw, 3.9rem);
    color: #fff;
    text-shadow: 0 2px 28px rgb(0 0 0 / 0.45);
  }

  .lead-text .deck {
    font-size: var(--text-lg);
    color: rgb(255 255 255 / 0.92);
    max-width: 38rem;
  }

  .lead-story .kicker {
    color: rgb(255 255 255 / 0.9);
  }

  .lead-story .byline {
    color: rgb(255 255 255 / 0.75);
  }

  .lead-story .byline-author {
    color: #fff;
  }

  .lead-story .tag {
    border-color: rgb(255 255 255 / 0.45);
    color: rgb(255 255 255 / 0.9);
    background: rgb(255 255 255 / 0.14);
  }

  .lead-story:hover .headline {
    text-decoration: underline;
  }

  /* ---------- news grid ---------- */

  .section-rule {
    border-top: 1px solid var(--color-border);
    margin-top: 2.5rem;
  }

  .section-label {
    margin: 0.9rem 0 1.25rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-text-muted);
  }

  .news-grid {
    column-count: 3;
    column-gap: 2.5rem;
    column-rule: 1px solid var(--color-border);
  }

  .news-item {
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
  }

  .news-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .news-bg :global(.post-index-hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .news-card:hover .news-bg :global(.post-index-hero-image) {
    transform: scale(1.045);
  }

  .news-card-text {
    position: relative;
    z-index: 1;
    padding: 1.1rem 1.25rem 1.25rem;
    color: #fff;
    background: linear-gradient(to top, rgb(0 23 255 / 82%) 0%, rgb(0 0 0 / 0.38) 40%, rgb(0 0 0 / 0) 80%);
  }

  .news-card .kicker {
    color: rgb(255 255 255 / 0.9);
    margin-bottom: 0.5rem;
  }

  .news-card .headline {
    font-size: clamp(1.3rem, 1.7vw, 1.7rem);
    color: #fff;
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.4);
  }

  .news-card:hover .headline {
    text-decoration: underline;
  }

  .news-card .deck {
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.85);
    margin-top: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-card .byline {
    color: rgb(255 255 255 / 0.75);
  }

  .news-card .byline-author {
    color: #fff;
  }

  /* ---------- responsive ---------- */

  @media (max-width: 980px) {
    .news-grid {
      column-count: 2;
    }
  }

  @media (max-width: 620px) {
    .paper {
      padding: 1.25rem 1.1rem 4rem;
    }
    .masthead-topline {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
    .news-grid {
      column-count: 1;
      column-rule: none;
    }
  }
</style>
